<%- include('partials/header',{page:'contracts',pageTitle:'Контракты — DropStorm'}) %>
<main class="page-content">
<div style="text-align:center;margin-bottom:24px;">
  <h1 style="font-size:26px;font-weight:900;text-transform:uppercase;">📋 Контракты</h1>
  <p style="font-size:11px;color:rgba(255,255,255,.35);letter-spacing:2px;text-transform:uppercase;margin-top:4px;">Обменяй от 3 до 10 предметов на один лучше</p>
</div>
<div class="contracts-builder">
  <div>
    <div class="glass" style="padding:22px;margin-bottom:16px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <div class="section-title" style="margin:0">Выбранные предметы</div>
        <span style="font-size:13px;color:rgba(255,255,255,.4)"><span id="sel-count" style="color:var(--gold);font-weight:800">0</span> / 10</span>
      </div>
      <div class="contract-slots-grid" id="slots"></div>
      <div style="margin-bottom:16px;">
        <div style="font-size:11px;color:rgba(255,255,255,.35);margin-bottom:5px;display:flex;justify-content:space-between;"><span>Прогресс</span><span id="prog-lbl">0 из 10</span></div>
        <div class="progress-bg"><div class="progress-fill" id="prog-fill" style="width:0%"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
        <div style="background:rgba(255,255,255,.03);border-radius:var(--r);padding:12px;text-align:center;">
          <div style="font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Стоимость</div>
          <div style="font-size:20px;font-weight:900;color:var(--gold)" id="total-val">0₽</div>
        </div>
        <div style="background:rgba(255,255,255,.03);border-radius:var(--r);padding:12px;text-align:center;">
          <div style="font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Шанс</div>
          <div style="font-size:20px;font-weight:900;color:var(--c-epic)" id="chance-val">—</div>
        </div>
      </div>
      <button class="btn btn-gold btn-full btn-lg" id="contract-btn" disabled style="opacity:.4;cursor:not-allowed" onclick="doContract()">📋 Создать контракт</button>
    </div>
    <div class="glass" style="padding:18px;">
      <div class="section-title">Ваш инвентарь</div>
      <div class="mini-grid" id="inv-pick">
        <% items.forEach(item=>{ %>
        <div class="mini-item" onclick="addToContract(<%- JSON.stringify(item) %>)" id="pick-<%=item.id%>">
          <div style="font-size:8.5px;color:var(--gold);font-weight:800;text-align:right;"><%=item.price.toLocaleString('ru-RU')%>₽</div>
          <div class="mi-ph"><%=item.emoji||'🔫'%></div>
          <div class="mi-name" style="color:<%={legendary:'var(--c-legend)',epic:'var(--c-epic)',rare:'var(--c-rare)',uncommon:'var(--c-uncommon)',common:'var(--c-common)'}[item.rarity]%>"><%=item.skin%></div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
  <div>
    <div class="glass" style="padding:22px;margin-bottom:14px;">
      <div class="section-title">Результат контракта</div>
      <div id="result-preview" style="min-height:180px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:rgba(255,255,255,.25);">
        <span style="font-size:38px">🎁</span>
        <span style="font-size:12px;text-align:center">Добавьте 3–10 предметов одной редкости</span>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;">
      <% [['common','uncommon','Обычный','Необычный'],['uncommon','rare','Необычный','Редкий'],['rare','epic','Редкий','Эпический'],['epic','legendary','Эпический','Легендарный']].forEach(([f,t,fR,tR])=>{ %>
      <div style="background:var(--card);border:1px solid rgba(255,255,255,.06);border-radius:var(--r);padding:11px 14px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;">
        <span style="color:<%={common:'var(--c-common)',uncommon:'var(--c-uncommon)',rare:'var(--c-rare)',epic:'var(--c-epic)'}[f]%>"><%=fR%> ×3–10</span>
        <span style="color:rgba(255,255,255,.3);font-size:16px">→</span>
        <span style="color:<%={uncommon:'var(--c-uncommon)',rare:'var(--c-rare)',epic:'var(--c-epic)',legendary:'var(--c-legend)'}[t]%>">1 <%=tR%></span>
      </div>
      <% }) %>
    </div>
    <div style="margin-top:14px;padding:12px 15px;border-radius:var(--r);background:rgba(255,123,66,.07);border:1px solid rgba(255,123,66,.18);font-size:11px;color:rgba(255,255,255,.35);line-height:1.6;">
      ⚠️ Контракт необратим. Все предметы будут удалены из инвентаря.
    </div>
  </div>
</div>
</main>
<%- include('partials/footer') %>
<div class="modal-overlay" id="cr-modal">
  <div class="modal" style="text-align:center;">
    <div style="font-size:56px;margin-bottom:12px" id="cr-emoji">🎁</div>
    <div style="font-size:16px;font-weight:900;margin-bottom:6px" id="cr-title">Контракт выполнен!</div>
    <div style="font-size:14px;font-weight:800;color:var(--gold);margin-bottom:4px" id="cr-item"></div>
    <div style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:22px" id="cr-sub"></div>
    <div style="display:flex;gap:10px;justify-content:center;">
      <button class="btn btn-ghost" onclick="closeModal('cr-modal');location.reload()">Закрыть</button>
      <button class="btn btn-gold" onclick="window.location='/inventory'">🎒 Инвентарь</button>
    </div>
  </div>
</div>
<script>
const ALL_ITEMS=<%- JSON.stringify(items) %>;
let selected=[];
const MAX=10;
function renderSlots(){
  const g=document.getElementById('slots'); g.innerHTML='';
  for(let i=0;i<MAX;i++){
    const d=document.createElement('div'); d.className='cslot'+(selected[i]?' filled':'');
    if(selected[i]){
      d.innerHTML=`<button onclick="removeSlot(${i})" style="position:absolute;top:2px;right:2px;width:15px;height:15px;background:rgba(239,68,68,.8);border:none;border-radius:50%;color:#fff;font-size:9px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:5;">✕</button>
        <div style="font-size:18px">${selected[i].emoji||'🔫'}</div>
        <div style="font-size:7.5px;font-weight:800;color:var(--gold)">${selected[i].price.toLocaleString('ru-RU')}₽</div>`;
    } else { d.textContent='+'; }
    g.appendChild(d);
  }
}
function updateUI(){
  const n=selected.length;
  document.getElementById('sel-count').textContent=n;
  document.getElementById('prog-lbl').textContent=`${n} из ${MAX}`;
  document.getElementById('prog-fill').style.width=(n/MAX*100)+'%';
  const tv=selected.reduce((s,i)=>s+i.price,0);
  document.getElementById('total-val').textContent=tv.toLocaleString('ru-RU')+'₽';
  const btn=document.getElementById('contract-btn');
  if(n>=3){
    const chance=Math.min(95,30+n*6);
    document.getElementById('chance-val').textContent=chance+'%';
    btn.disabled=false; btn.style.opacity='1'; btn.style.cursor='pointer';
    const RC={legendary:'var(--c-legend)',epic:'var(--c-epic)',rare:'var(--c-rare)',uncommon:'var(--c-uncommon)',common:'var(--c-common)'};
    const rUp={common:'uncommon',uncommon:'rare',rare:'epic',epic:'legendary'};
    const rar=selected[0]?.rarity||'common', next=rUp[rar]||'legendary';
    document.getElementById('result-preview').innerHTML=`
      <div style="width:72px;height:72px;border-radius:12px;background:linear-gradient(135deg,#1e2030,#2a2c3e);border:2px solid ${RC[next]};box-shadow:0 0 18px ${RC[next]}60;display:flex;align-items:center;justify-content:center;font-size:32px">🎁</div>
      <div style="font-size:13px;font-weight:800;color:${RC[next]}">${{common:'Обычный',uncommon:'Необычный',rare:'Редкий',epic:'Эпический',legendary:'Легендарный'}[next]}</div>
      <div style="font-size:20px;font-weight:900;color:var(--gold)">${Math.round(tv*(.8+n*.08)).toLocaleString('ru-RU')}₽</div>
      <div style="font-size:11px;color:rgba(255,255,255,.3)">Шанс получить: ${chance}%</div>`;
  } else {
    document.getElementById('chance-val').textContent='—';
    btn.disabled=true; btn.style.opacity='.4'; btn.style.cursor='not-allowed';
    if(n<3) document.getElementById('result-preview').innerHTML='<span style="font-size:38px">🎁</span><span style="font-size:12px;color:rgba(255,255,255,.25);text-align:center">Добавьте ещё '+(3-n)+' предмет(ов)</span>';
  }
}
function addToContract(item){
  if(selected.length>=MAX){showToast('Максимум 10 предметов','error');return;}
  if(selected.find(i=>i.id===item.id)){showToast('Уже выбран','error');return;}
  if(selected.length>0&&selected[0].rarity!==item.rarity){showToast('Все предметы должны быть одной редкости!','error');return;}
  selected.push(item);
  document.getElementById('pick-'+item.id).style.opacity='.35';
  document.getElementById('pick-'+item.id).style.pointerEvents='none';
  renderSlots(); updateUI();
}
function removeSlot(i){
  const item=selected[i]; selected.splice(i,1);
  const el=document.getElementById('pick-'+item.id);
  if(el){el.style.opacity='1';el.style.pointerEvents='';}
  renderSlots(); updateUI();
}
async function doContract(){
  if(selected.length<3)return;
  const ids=selected.map(i=>i.id);
  const r=await fetch('/api/contract',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids})});
  const d=await r.json();
  if(!d.success){showToast(d.error||'Ошибка','error');return;}
  const em=d.won?'🏆':'💔';
  document.getElementById('cr-emoji').textContent=em;
  document.getElementById('cr-title').textContent=d.won?'Контракт успешен!':'Контракт провален';
  document.getElementById('cr-item').textContent=d.won&&d.item?`${d.item.gun} | ${d.item.skin}`:'';
  document.getElementById('cr-sub').textContent=d.won&&d.item?`${d.item.price.toLocaleString('ru-RU')}₽`:'Предметы утрачены';
  if(d.won) triggerFlash(), goldBurst(window.innerWidth/2,window.innerHeight/3,35);
  openModal('cr-modal');
  selected=[];renderSlots();updateUI();
  document.querySelectorAll('#inv-pick .mini-item').forEach(el=>{el.style.opacity='1';el.style.pointerEvents='';});
}
renderSlots(); updateUI();
</script>
