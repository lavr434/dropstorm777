<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Регистрация — DropStorm</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    @keyframes floatP{0%{transform:translateY(100vh) scale(0);opacity:0}10%{opacity:.6}90%{opacity:.3}100%{transform:translateY(-20px) scale(1.4);opacity:0}}
    .part{position:fixed;border-radius:50%;background:radial-gradient(circle,rgba(245,197,66,.7),transparent);pointer-events:none;animation:floatP linear infinite}
    .auth-lightning{position:fixed;top:0;bottom:0;pointer-events:none;z-index:0;opacity:.5}
  </style>
</head>
<body style="background:var(--bg)">
<div class="noise-overlay"></div>
<svg class="auth-lightning" style="left:0;width:180px" viewBox="0 0 180 900" preserveAspectRatio="xMidYMid slice">
  <path d="M110 0 L70 200 L130 200 L50 500 L120 500 L15 900" stroke="#f5c542" stroke-width="2" fill="none" opacity=".5"/>
</svg>
<svg class="auth-lightning" style="right:0;width:180px" viewBox="0 0 180 900" preserveAspectRatio="xMidYMid slice">
  <path d="M70 0 L110 200 L50 200 L130 500 L60 500 L165 900" stroke="#ff7b42" stroke-width="2" fill="none" opacity=".5"/>
</svg>
<div id="particles" style="position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden"></div>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-wrap">
      <a href="/" style="text-decoration:none">
        <span style="font-size:26px;font-weight:900;letter-spacing:-.5px">DROP<span style="animation:bpulse 2s ease-in-out infinite;display:inline-block">⚡</span><span style="color:var(--gold)">STORM</span></span>
      </a>
    </div>
    <h2 class="auth-t">Создать аккаунт</h2>
    <p class="auth-sub">Регистрируйся и получи бонус <span style="color:var(--gold);font-weight:800">+500₽</span></p>

    <div style="background:rgba(34,197,94,.07);border:1px solid rgba(34,197,94,.2);border-radius:var(--r);padding:10px 13px;margin-bottom:18px;font-size:11.5px;color:var(--green);font-weight:700;">
      🎁 Новым игрокам — приветственный бонус 500₽ + 3 жетона колеса
    </div>

    <form action="/register" method="POST">
      <% if(typeof error!=='undefined'&&error){ %><div class="auth-error">❌ <%=error%></div><% } %>
      <div class="form-group">
        <label class="form-label">Никнейм (мин. 3 символа)</label>
        <input type="text" name="username" class="form-input" placeholder="Придумайте никнейм" required minlength="3"/>
      </div>
      <div class="form-group">
        <label class="form-label">Пароль (мин. 6 символов)</label>
        <input type="password" name="password" id="pwd" class="form-input" placeholder="Минимум 6 символов" required minlength="6" oninput="checkPwd(this.value)"/>
        <div style="display:flex;gap:3px;margin-top:5px;">
          <div id="s1" style="flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.08)"></div>
          <div id="s2" style="flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.08)"></div>
          <div id="s3" style="flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.08)"></div>
          <div id="s4" style="flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.08)"></div>
        </div>
        <div id="pwd-lbl" style="font-size:10px;color:rgba(255,255,255,.35);margin-top:3px;"></div>
      </div>
      <div class="form-group">
        <label class="form-label">Повтор пароля</label>
        <input type="password" name="confirm_password" id="pwd2" class="form-input" placeholder="Повторите пароль" required oninput="checkMatch()"/>
        <div id="match-lbl" style="font-size:10px;margin-top:3px;"></div>
      </div>
      <div class="form-group">
        <label class="form-label" style="font-size:11px;color:rgba(255,255,255,.35)">Промокод (необязательно)</label>
        <input type="text" name="promo" class="form-input" placeholder="Введите промокод"/>
      </div>
      <div style="margin-bottom:18px;font-size:11px;color:rgba(255,255,255,.35);">
        <label style="display:flex;align-items:start;gap:7px;cursor:pointer;">
          <input type="checkbox" name="agree" required style="accent-color:var(--gold);margin-top:1px;flex-shrink:0"/>
          Я соглашаюсь с <a href="#" style="color:var(--gold)">Условиями использования</a> и подтверждаю возраст 18+
        </label>
      </div>
      <button type="submit" class="btn btn-gold btn-full btn-lg">🚀 Создать аккаунт</button>
    </form>
    <div class="auth-switch">Уже есть аккаунт? <a href="/login">Войти</a></div>
  </div>
</div>
<script>
const c=document.getElementById('particles');
for(let i=0;i<16;i++){const p=document.createElement('div');p.className='part';const s=2+Math.random()*5;p.style.cssText=`width:${s}px;height:${s}px;left:${Math.random()*100}%;animation-duration:${6+Math.random()*8}s;animation-delay:${-Math.random()*10}s;`;c.appendChild(p);}
const CLR=['var(--red)','var(--orange)','var(--gold)','var(--green)'];
const LBL=['Слабый','Средний','Хороший','Отличный'];
function checkPwd(v){
  let sc=0;if(v.length>=6)sc++;if(/[A-Z]/.test(v))sc++;if(/[0-9]/.test(v))sc++;if(/[^A-Za-z0-9]/.test(v))sc++;
  [1,2,3,4].forEach(i=>{document.getElementById('s'+i).style.background=i<=sc?CLR[Math.min(sc-1,3)]:'rgba(255,255,255,.08)';});
  document.getElementById('pwd-lbl').textContent=sc>0?LBL[Math.min(sc-1,3)]:'';
  document.getElementById('pwd-lbl').style.color=sc>0?CLR[Math.min(sc-1,3)]:'';
}
function checkMatch(){
  const p1=document.getElementById('pwd').value, p2=document.getElementById('pwd2').value;
  const l=document.getElementById('match-lbl');
  if(!p2)return; l.textContent=p1===p2?'✓ Пароли совпадают':'✗ Пароли не совпадают';
  l.style.color=p1===p2?'var(--green)':'var(--red)';
}
</script>
</body></html>
